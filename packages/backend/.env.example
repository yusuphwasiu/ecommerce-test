# Backend Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (for future PostgreSQL integration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=checkout_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Email Service (for future email integration)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your_api_key_here
EMAIL_FROM=noreply@checkout.example.com

# Payment Service (for future payment integration)
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=your_secret_key_here
PAYMENT_PUBLIC_KEY=your_public_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Security
JWT_SECRET=your_jwt_secret_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
